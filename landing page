<style>
:root{
  --bg:#fcf4f3;
  --bg-alt:#f6e5e4;
  --surface:#fffbfa;
  --text:#3b2224;
  --muted:#7a5a5c;
  --line:rgba(59,34,36,.17);
  --rose:#a4544f;
  --btn:#a4544f;
  --btn-hover:#8a413d;
  --on-btn:#ffffff;
  --header-bg:rgba(252,244,243,.9);
  --ink:#4a2a2b;
  --serif:'Bodoni Moda','Didot','Bodoni 72',Georgia,'Times New Roman',serif;
  --sans:'Jost','Futura','Century Gothic',system-ui,-apple-system,'Segoe UI',Roboto,sans-serif;
  --script:'Pinyon Script','Snell Roundhand','Brush Script MT',cursive;
  box-sizing:border-box;
  padding-top:env(safe-area-inset-top,0px);
  padding-bottom:env(safe-area-inset-bottom,0px);
}
@media (prefers-color-scheme: dark){
  :root:not([data-theme="light"]){
    --bg:#1c1213;
    --bg-alt:#261a1b;
    --surface:#2c1d1f;
    --text:#f8ebeb;
    --muted:#c6a6a8;
    --line:rgba(248,235,235,.18);
    --rose:#eaa19c;
    --btn:#eaa19c;
    --btn-hover:#f5b6b1;
    --on-btn:#2a1416;
    --header-bg:rgba(28,18,19,.9);
  }
}
:root[data-theme="dark"]{
  --bg:#1c1213;
  --bg-alt:#261a1b;
  --surface:#2c1d1f;
  --text:#f8ebeb;
  --muted:#c6a6a8;
  --line:rgba(248,235,235,.18);
  --rose:#eaa19c;
  --btn:#eaa19c;
  --btn-hover:#f5b6b1;
  --on-btn:#2a1416;
  --header-bg:rgba(28,18,19,.9);
}

.p-blush{--wb:#f7dcdc;--w1:#efb4b6;--w2:#f9eaea}
.p-rose{--wb:#eebfc0;--w1:#d98d8f;--w2:#f6d4d4}
.p-champagne{--wb:#f3e3cf;--w1:#e5c3a4;--w2:#f8efe2}
.p-mauve{--wb:#e6c8cf;--w1:#c99aa8;--w2:#f3dfe3}
.p-petal{--wb:#fbe9e7;--w1:#f2c4bf;--w2:#fff5f3}

*,*::before,*::after{box-sizing:inherit}
html{scroll-padding-top:calc(env(safe-area-inset-top,0px) + 4.75rem);scroll-behavior:smooth}
body{
  margin:0;background:var(--bg);color:var(--text);
  font-family:var(--sans);font-size:1.0625rem;font-weight:400;line-height:1.65;
  -webkit-font-smoothing:antialiased;
}
h1,h2,h3,p,ul,figure{margin:0}
ul{padding:0;list-style:none}
a{color:inherit}
h1,h2,h3{font-family:var(--serif);font-weight:500;font-synthesis:none;font-optical-sizing:auto}
:focus-visible{outline:2px solid var(--rose);outline-offset:3px}
.wrap{width:min(100% - 2.5rem,74rem);margin-inline:auto}

.btn{
  display:inline-flex;align-items:center;justify-content:center;gap:.65rem;
  padding:.95rem 1.7rem;border:1px solid transparent;border-radius:999px;
  font:500 .98rem/1.2 var(--sans);letter-spacing:.03em;text-decoration:none;cursor:pointer;
  transition:background-color .2s,color .2s,border-color .2s;
}
.btn svg{width:1.15rem;height:1.15rem;flex:none}
.btn-solid{background:var(--btn);color:var(--on-btn)}
.btn-solid:hover{background:var(--btn-hover)}
.btn-line{border-color:var(--rose);color:var(--rose)}
.btn-line:hover{background:var(--btn);color:var(--on-btn);border-color:var(--btn)}
.btn-small{padding:.6rem 1.2rem;font-size:.9rem}

.site-header{
  position:sticky;top:env(safe-area-inset-top,0px);z-index:20;
  background:var(--header-bg);
  -webkit-backdrop-filter:blur(10px);backdrop-filter:blur(10px);
  border-bottom:1px solid var(--line);
}
.site-header .wrap{display:flex;align-items:center;gap:1.5rem;min-height:4.5rem}
.brand{display:flex;flex-direction:column;align-items:flex-start;text-decoration:none;margin-right:auto;line-height:1}
.brand .script{font:400 2rem/.9 var(--script);color:var(--rose)}
.brand .bq{font:700 .62rem/1 var(--serif);letter-spacing:.32em;text-transform:uppercase;color:var(--text);margin-top:.2rem;padding-left:.15rem}
.nav{display:flex;gap:2rem}
.nav a{text-decoration:none;font-size:.95rem;font-weight:400;letter-spacing:.04em;color:var(--muted)}
.nav a:hover{color:var(--text)}
.site-header .btn .short{display:none}

.hero{position:relative;overflow:hidden;padding:clamp(2.5rem,6vw,5rem) 0 clamp(3rem,7vw,6rem)}
.hero-wash{position:absolute;right:-12%;top:-8%;width:min(70vw,52rem);aspect-ratio:1;z-index:0;pointer-events:none;opacity:.55}
.hero-wash svg{width:100%;height:100%;display:block}
.hero .wrap{position:relative;z-index:1;display:grid;grid-template-columns:1.05fr .95fr;gap:clamp(2rem,5vw,4rem);align-items:center}
.hero h1{font-size:clamp(3rem,8.2vw,6.6rem);line-height:.96;letter-spacing:-.02em}
.hero .lead{margin-top:1.6rem;max-width:30rem;font-size:clamp(1.05rem,2.2vw,1.2rem);color:var(--muted);font-weight:300}
.hero-actions{display:flex;flex-wrap:wrap;gap:.85rem;margin-top:2.1rem}
.where{display:flex;gap:.6rem;align-items:flex-start;margin-top:2rem;max-width:30rem;font-size:.95rem;color:var(--muted)}
.where svg{width:1.15rem;height:1.15rem;flex:none;margin-top:.2rem;color:var(--rose)}

.arches{display:flex;align-items:flex-end;justify-content:center;gap:clamp(.6rem,1.6vw,1.1rem);height:clamp(19rem,50vw,31rem)}
.arch{position:relative;overflow:hidden;flex:1;border-radius:999px 999px 6px 6px;background:var(--wb)}
.arches .arch:nth-child(1){height:76%}
.arches .arch:nth-child(2){height:100%}
.arches .arch:nth-child(3){height:87%}
.arch .wash{position:absolute;inset:0;width:100%;height:100%;display:block}
.arch .art{position:absolute;inset:0;display:grid;place-items:center;padding:14% 10% 8%}
.g{width:100%;max-height:100%;fill:none;stroke:var(--ink);stroke-width:1.5px;stroke-linecap:round;stroke-linejoin:round}
.g *{vector-effect:non-scaling-stroke}
.g .b{fill:rgba(255,255,255,.34)}
.g .dot{fill:#fdf5f3}
.js .arches .arch{clip-path:inset(100% 0 0 0)}
.js .ready .arches .arch{clip-path:inset(0 0 0 0);transition:clip-path 1.3s cubic-bezier(.2,.8,.2,1) var(--d)}

section{padding:clamp(3.5rem,8vw,6.5rem) 0}
.section-head{max-width:38rem;margin-bottom:clamp(1.75rem,4vw,3rem)}
.section-head h2{font-size:clamp(2.3rem,5.4vw,4rem);line-height:1;letter-spacing:-.018em}
.section-head p{margin-top:1rem;color:var(--muted);font-weight:300;font-size:1.1rem}

.index{display:grid;grid-template-columns:1.25fr .75fr;gap:clamp(2rem,6vw,5rem);align-items:start}
.rows{border-top:1px solid var(--line)}
.row{
  display:grid;grid-template-columns:1fr auto auto;align-items:center;gap:1.25rem;
  padding:1rem .25rem;border-bottom:1px solid var(--line);text-decoration:none;
  transition:background-color .25s,padding .25s;
}
.row .name{font:500 clamp(2.1rem,5vw,3.8rem)/1 var(--serif);letter-spacing:-.015em}
.row .mini{width:3.1rem;height:3.8rem;border-radius:999px 999px 4px 4px;background:var(--wb);display:grid;place-items:center;padding:.5rem .35rem .3rem}
.row .go{font-size:.92rem;font-weight:500;color:var(--rose);text-decoration:underline;text-underline-offset:.35em;letter-spacing:.03em}
.row.on,.row:hover{background:var(--bg-alt);padding-left:1rem}
.preview{position:sticky;top:calc(env(safe-area-inset-top,0px) + 6rem)}
.preview .arch{width:100%;max-width:24rem;aspect-ratio:3 / 4;margin-inline:auto}
.preview .art{opacity:0;transition:opacity .35s ease}
.preview .art.on{opacity:1}
.preview .cap{margin-top:.9rem;text-align:center;font-size:.9rem;color:var(--muted)}

#pedido{background:var(--bg-alt)}
.order{display:grid;grid-template-columns:.9fr 1.1fr;gap:clamp(2rem,6vw,5rem);align-items:start}
.order .section-head{margin-bottom:0}
.order-form{background:var(--surface);border:1px solid var(--line);border-radius:22px;padding:clamp(1.4rem,3.5vw,2.3rem);display:grid;gap:1.1rem}
.field{display:grid;gap:.4rem}
.field label{font-size:.92rem;font-weight:500;letter-spacing:.02em}
.field input,.field select,.field textarea{
  width:100%;padding:.8rem .95rem;border-radius:12px;border:1px solid var(--line);
  background:var(--bg);color:var(--text);font:inherit;
}
.field textarea{min-height:6rem;resize:vertical}
.field input:focus,.field select:focus,.field textarea:focus{outline:2px solid var(--rose);outline-offset:0;border-color:transparent}
.two{display:grid;grid-template-columns:1.2fr .8fr;gap:1rem}
.order-form .btn{justify-self:start}
.hint{font-size:.9rem;color:var(--muted)}

.visit{display:grid;grid-template-columns:1.15fr .85fr;gap:clamp(2rem,6vw,5rem);align-items:center}
.visit h2{font-size:clamp(2.4rem,6.2vw,4.8rem);line-height:.98;letter-spacing:-.02em}
.visit address{font-style:normal;margin-top:1.5rem;color:var(--muted);font-weight:300;font-size:1.12rem;max-width:30rem}
.visit .btns{display:flex;flex-wrap:wrap;gap:.8rem;margin-top:1.75rem}
.store{width:100%;max-width:22rem;aspect-ratio:3 / 4;margin-inline:auto;position:relative}
.store .art{position:absolute;inset:0;display:grid;place-items:center;padding:10% 8% 6%}
.store text{font-family:var(--script);fill:var(--ink)}

.insta{background:#3b2224;color:#f8ebeb;padding:clamp(3rem,7vw,5rem) 0}
.insta .wrap{display:flex;flex-wrap:wrap;align-items:center;justify-content:space-between;gap:1.5rem 3rem}
.insta h2{font-size:clamp(1.9rem,4.2vw,3rem);line-height:1.05;max-width:20ch}
.insta p{margin-top:.6rem;color:rgba(248,235,235,.75);font-weight:300}
.insta .btn-line{border-color:#f3c9c6;color:#f3c9c6}
.insta .btn-line:hover{background:#f3c9c6;color:#3b2224;border-color:#f3c9c6}

footer{padding:clamp(3rem,6vw,4.5rem) 0 2rem;border-top:1px solid var(--line)}
.foot{display:grid;grid-template-columns:1.2fr 1fr 1fr;gap:2.5rem}
.foot h3{font-size:1.15rem;margin-bottom:.7rem}
.foot p,.foot a{color:var(--muted);text-decoration:none;font-size:.98rem;font-weight:300}
.foot a:hover{color:var(--rose)}
.foot li+li{margin-top:.4rem}
.copy{margin-top:2.5rem;padding-top:1.25rem;border-top:1px solid var(--line);font-size:.85rem;color:var(--muted)}

.float{
  position:fixed;right:1rem;bottom:calc(1rem + env(safe-area-inset-bottom,0px));z-index:30;
  width:3.6rem;height:3.6rem;border-radius:50%;
  display:grid;place-items:center;background:var(--btn);color:var(--on-btn);
  box-shadow:0 10px 24px -8px rgba(0,0,0,.45);
}
.float svg{width:1.7rem;height:1.7rem}
.float:hover{background:var(--btn-hover)}

@media (max-width:900px){
  .hero .wrap,.order,.visit{grid-template-columns:1fr}
  .hero-wash{right:-30%;width:90vw}
  .arches{max-width:32rem;margin-inline:auto;width:100%}
  .index{grid-template-columns:1fr}
  .preview{display:none}
  .foot{grid-template-columns:1fr 1fr}
  .foot > :first-child{grid-column:1 / -1}
  .store{max-width:17rem;margin-inline:0}
}
@media (max-width:760px){
  .nav{display:none}
}
@media (max-width:520px){
  .two{grid-template-columns:1fr}
  .site-header .btn span.long{display:none}
  .site-header .btn span.short{display:inline}
  .hero-actions .btn{flex:1 1 100%}
  .row{grid-template-columns:1fr auto;gap:.9rem}
  .row .go{display:none}
}
@media (prefers-reduced-motion: reduce){
  html{scroll-behavior:auto}
  .js .arches .arch{clip-path:none;transition:none}
  .preview .art{transition:none}
}
</style>
</head>
