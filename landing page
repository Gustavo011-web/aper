<script>
(function(){
  var WHATSAPP = '';
  var IG_USER = 'aper_boutiquestyle_';

  try { document.getElementById('ano').textContent = new Date().getFullYear(); } catch(e){}

  function canal(texto){
    if (WHATSAPP) return 'https://wa.me/' + WHATSAPP + '?text=' + encodeURIComponent(texto);
    return 'https://ig.me/m/' + IG_USER;
  }

  var hello = 'Olá! Vim pelo site da AP&R Boutique Style e gostaria de fazer um pedido.';
  document.querySelectorAll('a[data-order]').forEach(function(a){ a.href = canal(hello); });

  var G = {
    jeans:'<path class="b" d="M38 14H82L90 128H67L60 62L53 128H30Z"/><path d="M38 22H82" stroke-dasharray="2 2.5"/><path d="M40 26C42 40 51 42 57 35"/><path d="M80 26C78 40 69 42 63 35"/><path d="M60 22V62" stroke-dasharray="2 2.5"/><path d="M33 118H51M69 118H87" stroke-dasharray="2 2.5"/><circle class="dot" cx="41" cy="27" r="1.4"/><circle class="dot" cx="79" cy="27" r="1.4"/>',
    moletons:'<path class="b" d="M46 18C50 8 70 8 74 18L102 32L98 80L86 78V118H34V78L22 80L18 32Z"/><path d="M46 18C50 34 70 34 74 18"/><path d="M55 31V50M65 31V50"/><path d="M45 92H75L71 110H49Z"/><path d="M34 108H86"/>',
    calcas:'<path class="b" d="M38 14H82L90 128H67L60 62L53 128H30Z"/><path d="M38 24H82"/><path d="M60 24V62"/><path d="M48 24L47 48"/><path d="M72 24L73 48"/>',
    camisas:'<path class="b" d="M44 16L18 30L14 84L28 86L34 54V124H86V54L92 86L106 84L102 30L76 16L60 32Z"/><path d="M44 16L54 28L60 32L66 28L76 16"/><path d="M60 32V124"/><circle class="dot" cx="60" cy="46" r="1.6"/><circle class="dot" cx="60" cy="64" r="1.6"/><circle class="dot" cx="60" cy="82" r="1.6"/><circle class="dot" cx="60" cy="100" r="1.6"/><path d="M68 58H80V70L74 73L68 70Z"/>',
    vestidos:'<path class="b" d="M46 12L50 42C50 48 44 52 42 58L24 128C44 134 76 134 96 128L78 58C76 52 70 48 70 42L74 12"/><path d="M50 42C56 52 64 52 70 42"/><path d="M42 58H78"/><path d="M53 60L45 130M67 60L75 130"/>',
    body:'<path class="b" d="M44 12L47 38C48 50 40 58 40 72C40 88 50 100 60 100C70 100 80 88 80 72C80 58 72 50 73 38L76 12"/><path d="M47 38C54 47 66 47 73 38"/><path d="M54 100V108H66V100"/><circle class="dot" cx="60" cy="104" r="1.4"/>',
    tshirt:'<path class="b" d="M40 18L16 32L26 54L38 47V120H82V47L94 54L104 32L80 18C76 30 44 30 40 18Z"/><path d="M41 19C46 34 74 34 79 19"/>'
  };
  var CAT = {
    jeans:'p-champagne', moletons:'p-mauve', calcas:'p-blush', camisas:'p-petal',
    vestidos:'p-rose', body:'p-mauve', tshirt:'p-champagne'
  };
  function garment(k){ return '<svg class="g" viewBox="0 0 120 140" aria-hidden="true">' + G[k] + '</svg>'; }

  var uid = 0;
  function wash(){
    var u = uid++, s = 3 + u * 7;
    return '<svg class="wash" viewBox="0 0 300 400" preserveAspectRatio="xMidYMid slice" aria-hidden="true">'
      + '<defs>'
      + '<filter id="pw'+u+'" x="-30%" y="-30%" width="160%" height="160%">'
      + '<feTurbulence type="fractalNoise" baseFrequency=".012 .018" numOctaves="4" seed="'+s+'" result="n"/>'
      + '<feDisplacementMap in="SourceGraphic" in2="n" scale="60" xChannelSelector="R" yChannelSelector="G" result="d"/>'
      + '<feGaussianBlur in="d" stdDeviation="5"/></filter>'
      + '<filter id="pg'+u+'" x="0" y="0" width="100%" height="100%">'
      + '<feTurbulence type="fractalNoise" baseFrequency=".85" numOctaves="2" seed="'+s+'"/>'
      + '<feColorMatrix type="matrix" values="0 0 0 0 .45 0 0 0 0 .25 0 0 0 0 .25 .5 0 0 0 -.12"/></filter>'
      + '</defs>'
      + '<rect width="300" height="400" style="fill:var(--wb)"/>'
      + '<g filter="url(#pw'+u+')">'
      + '<ellipse cx="90" cy="120" rx="120" ry="90" style="fill:var(--w1)" opacity=".7"/>'
      + '<ellipse cx="220" cy="300" rx="130" ry="110" style="fill:var(--w2)" opacity=".9"/>'
      + '<ellipse cx="60" cy="330" rx="90" ry="60" style="fill:var(--w1)" opacity=".45"/>'
      + '</g>'
      + '<rect width="300" height="400" filter="url(#pg'+u+')" opacity=".55"/>'
      + '</svg>';
  }

  document.querySelectorAll('[data-arch]').forEach(function(el){
    el.insertAdjacentHTML('beforeend', wash() + '<div class="art">' + garment(el.getAttribute('data-arch')) + '</div>');
  });

  var big = document.querySelector('[data-bigwash]');
  if (big){
    big.innerHTML = '<svg viewBox="0 0 600 600" aria-hidden="true"><defs>'
      + '<filter id="bw" x="-30%" y="-30%" width="160%" height="160%">'
      + '<feTurbulence type="fractalNoise" baseFrequency=".006 .009" numOctaves="4" seed="11" result="n"/>'
      + '<feDisplacementMap in="SourceGraphic" in2="n" scale="140" xChannelSelector="R" yChannelSelector="G" result="d"/>'
      + '<feGaussianBlur in="d" stdDeviation="14"/></filter></defs>'
      + '<g filter="url(#bw)"><ellipse cx="320" cy="260" rx="230" ry="190" fill="#efb4b6" opacity=".55"/>'
      + '<ellipse cx="200" cy="400" rx="170" ry="120" fill="#f5cfc9" opacity=".7"/></g></svg>';
  }

  document.querySelectorAll('[data-g]').forEach(function(el){
    el.innerHTML = garment(el.getAttribute('data-g'));
  });

  var st = document.querySelector('[data-store]');
  if (st) st.insertAdjacentHTML('afterbegin', wash());

  var pv = document.getElementById('pv');
  var keys = Object.keys(G);
  if (pv){
    var html = wash();
    keys.forEach(function(k){ html += '<div class="art" data-k="'+k+'">' + garment(k) + '</div>'; });
    pv.insertAdjacentHTML('beforeend', html);
  }
  var rows = document.querySelectorAll('.row');
  function ativar(k){
    rows.forEach(function(r){ r.classList.toggle('on', r.getAttribute('data-k') === k); });
    if (!pv) return;
    Object.keys(CAT).forEach(function(key){ pv.classList.remove(CAT[key]); });
    pv.classList.add(CAT[k]);
    pv.querySelectorAll('.art').forEach(function(a){ a.classList.toggle('on', a.getAttribute('data-k') === k); });
  }
  rows.forEach(function(r){
    var k = r.getAttribute('data-k');
    r.addEventListener('mouseenter', function(){ ativar(k); });
    r.addEventListener('focus', function(){ ativar(k); });
    r.addEventListener('touchstart', function(){ ativar(k); }, {passive:true});
  });
  ativar('vestidos');

  var nome = document.getElementById('nome'),
      peca = document.getElementById('peca'),
      tam = document.getElementById('tam'),
      detalhes = document.getElementById('detalhes'),
      enviar = document.getElementById('enviar'),
      copiado = document.getElementById('copiado');

  var msg = '';
  function montar(){
    var t = hello + '\n\nPeça: ' + peca.value;
    if (tam.value.trim()) t += '\nTamanho: ' + tam.value.trim();
    if (detalhes.value.trim()) t += '\nDetalhes: ' + detalhes.value.trim();
    if (nome.value.trim()) t += '\n\nMeu nome: ' + nome.value.trim();
    msg = t;
    enviar.href = canal(t);
  }
  [nome, peca, tam, detalhes].forEach(function(el){
    el.addEventListener('input', montar);
    el.addEventListener('change', montar);
  });
  montar();

  enviar.addEventListener('click', function(){
    if (WHATSAPP) return;
    try {
      navigator.clipboard.writeText(msg).then(function(){
        copiado.textContent = 'Copiamos o seu pedido. Cole na conversa do Instagram que abriu.';
        copiado.hidden = false;
      }).catch(function(){});
    } catch(e){}
  });

  document.querySelectorAll('[data-peca]').forEach(function(a){
    a.addEventListener('click', function(){
      peca.value = a.getAttribute('data-peca');
      montar();
    });
  });

  var hero = document.getElementById('hero');
  requestAnimationFrame(function(){ requestAnimationFrame(function(){ hero.classList.add('ready'); }); });
})();
</script>
